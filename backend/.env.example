# Ion Filtra Backend Configuration
# Copy this file to .env and fill in your actual values

# 1. Server Configuration
PORT=3000
NODE_ENV=development

# 2. Database (Supabase PostgreSQL Connection URI)
DATABASE_URL=postgresql://postgres.your_project:your_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# 3. Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_me_in_production
HARDWARE_TOKEN=ion_sensor_hw_token_2026_never_expires
CRON_SECRET=IonDailyPing2026

# 4. Gemini AI Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here

# 5. Email Alerting Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
