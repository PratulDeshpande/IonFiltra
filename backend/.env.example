# Ion Filtra Backend Configuration
# Copy this file to .env and fill in your actual values

# 1. Server Configuration
PORT=3000
NODE_ENV=development

# 2. Database (Supabase PostgreSQL Connection URI)
DATABASE_URL=postgresql://postgres.your_project:your_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# 3. Security & Authentication (REQUIRED - server will not start without these)
JWT_SECRET=generate_a_random_64_char_string_here
HARDWARE_TOKEN=generate_a_random_token_for_esp32_gateway
CRON_SECRET=generate_a_random_secret_for_cron_jobs

# 4. Gemini AI Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here

# 5. Alerting Configuration (Optional - alerts log to console if not set)
GOOGLE_WEBHOOK_URL=https://script.google.com/macros/s/your_apps_script_id/exec
